---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const reviews = (await getCollection('reviews')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const localities = [...new Set(reviews.map((r) => r.data.locality).filter(Boolean))].sort();
const categories = [...new Set(reviews.flatMap((r) => r.data.categoryArray ?? []))].sort();
const maxPrice = Math.max(...reviews.map((r) => r.data.averagePrice ?? 0));

const reviewsForClient = reviews.map((r) => ({
  id: r.id,
  title: r.data.title,
  description: r.data.description,
  locality: r.data.locality,
  categories: r.data.categoryArray ?? [],
  averagePrice: r.data.averagePrice ?? 0,
  favorite: r.data.favorite,
  trending: r.data.trending,
  image: r.data.image ?? null,
  rating: r.data.rating
    ? ((r.data.rating.food + r.data.rating.service + r.data.rating.ambiance + r.data.rating.value) / 4).toFixed(1)
    : null,
}));

const mapPoints = reviews
  .filter((r) => r.data.coordinates)
  .map((r) => ({
    id: r.id,
    title: r.data.title,
    locality: r.data.locality,
    lat: r.data.coordinates!.lat,
    lng: r.data.coordinates!.lng,
    rating: r.data.rating
      ? ((r.data.rating.food + r.data.rating.service + r.data.rating.ambiance + r.data.rating.value) / 4).toFixed(1)
      : null,
  }));
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`Buscar — ${SITE_TITLE}`} description="Busca y filtra restaurantes por localidad, tipo de cocina, precio y más." />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
      #map { width: 100%; height: 400px; z-index: 0; border: 1px solid #2b2f3a; }
      .hide-scrollbar::-webkit-scrollbar { display: none; }
      .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
  </head>
  <body class="bg-surface-container-low text-on-surface min-h-screen flex flex-col antialiased" style="font-family:'Plus Jakarta Sans',sans-serif;">
    <Header />
    <main id="main-content" class="flex-grow w-full max-w-7xl mx-auto px-5 md:px-16 py-16">

      <!-- Page Header -->
      <div class="mb-8 border-b border-outline pb-8">
        <h1
          class="text-[clamp(2rem,4vw,3rem)] font-bold text-primary mb-2"
          style="font-family:'Playfair Display',serif; letter-spacing:-0.02em;"
        >
          Buscador de Restaurantes
        </h1>
        <p class="text-[16px] text-on-surface-variant">
          Filtra por nombre, localidad, tipo de cocina o rango de precio.
        </p>
      </div>

      <!-- Surprise Me -->
      <div class="flex flex-wrap gap-4 items-end p-6 border border-[#2b2f3a] bg-bright-linen mb-8 shadow-[4px_4px_0px_0px_#2b2f3a]">
        <div class="flex-1 min-w-[200px]">
          <label class="block text-[12px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Sorpréndeme en...</label>
          <select id="surprise-locality" class="w-full border border-[#2b2f3a] bg-surface-container-low px-4 py-3 text-[14px] text-on-surface focus:bg-surface-container-low focus:outline-none">
            <option value="">Todas las localidades</option>
            {localities.map((loc) => <option value={loc}>{loc}</option>)}
          </select>
        </div>
        <button id="btn-surprise"
          class="px-6 py-3 bg-on-tertiary-container text-white text-[14px] font-bold uppercase tracking-widest border border-[#2b2f3a] shadow-[4px_4px_0px_0px_#2b2f3a] hover:shadow-[2px_2px_0px_0px_#2b2f3a] hover:translate-x-[2px] hover:translate-y-[2px] transition-all">
          Sorpréndeme
        </button>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap gap-4 items-end p-6 border border-outline bg-surface-container mb-8">
        <div class="flex-1 min-w-[200px]">
          <label for="filter-search" class="block text-[12px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Buscar</label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline" style="font-size:18px;">search</span>
            <input id="filter-search" type="text" placeholder="Nombre o descripción..."
              class="w-full pl-10 pr-4 py-3 border border-[#2b2f3a] bg-surface focus:bg-surface-container-low focus:outline-none text-[16px] text-on-surface" />
          </div>
        </div>
        <div class="flex-1 min-w-[180px]">
          <label for="filter-locality" class="block text-[12px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Localidad</label>
          <select id="filter-locality" class="w-full border border-[#2b2f3a] bg-surface px-4 py-3 text-[14px] text-on-surface focus:bg-surface-container-low focus:outline-none">
            <option value="">Todas</option>
            {localities.map((loc) => <option value={loc}>{loc}</option>)}
          </select>
        </div>
        <div class="flex-1 min-w-[180px]">
          <label for="filter-category" class="block text-[12px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Cocina</label>
          <select id="filter-category" class="w-full border border-[#2b2f3a] bg-surface px-4 py-3 text-[14px] text-on-surface focus:bg-surface-container-low focus:outline-none">
            <option value="">Todas</option>
            {categories.map((cat) => <option value={cat}>{cat}</option>)}
          </select>
        </div>
        <div class="flex-1 min-w-[180px]">
          <label for="filter-price" class="block text-[12px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">
            Precio máx.: <span id="price-display">{maxPrice || 500}€</span>
          </label>
          <input id="filter-price" type="range" min="0" max={maxPrice || 500} step="5" value={maxPrice || 500}
            class="w-full accent-secondary" />
        </div>
        <div>
          <button id="btn-clear"
            class="px-4 py-3 border border-outline text-[14px] font-bold uppercase tracking-widest text-on-surface-variant hover:border-primary hover:text-primary transition-colors">
            Limpiar
          </button>
        </div>
      </div>

      <!-- Results info -->
      <p id="results-info" class="text-[14px] text-on-surface-variant mb-4 uppercase tracking-widest">
        Mostrando {reviews.length} restaurantes
      </p>

      <!-- Review Cards Grid -->
      <div id="reviews-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {reviews.map((review) => (
          <div
            class="review-card-wrapper"
            data-id={review.id}
            data-title={review.data.title.toLowerCase()}
            data-description={review.data.description?.toLowerCase() ?? ''}
            data-locality={review.data.locality ?? ''}
            data-categories={(review.data.categoryArray ?? []).join(',')}
            data-price={review.data.averagePrice ?? 0}
          >
            <a
              href={`/reviews/${review.id}/`}
              class="group flex flex-col border border-[#2b2f3a] bg-surface-bright hover:shadow-[4px_4px_0px_0px_#2b2f3a] hover:-translate-y-1 transition-all duration-300 h-full"
            >
              <div class="aspect-[4/3] w-full overflow-hidden border-b border-[#2b2f3a] relative">
                {review.data.rating && (
                  <div class="absolute top-4 left-4 bg-[#f86630] text-[#003049] text-[14px] font-bold px-3 py-1 border border-[#2b2f3a] z-10 shadow-[2px_2px_0px_0px_#003049] uppercase tracking-widest">
                    {((review.data.rating.food + review.data.rating.service + review.data.rating.ambiance + review.data.rating.value) / 4).toFixed(1)}/10
                  </div>
                )}
                {review.data.image ? (
                  <img src={review.data.image} alt={review.data.title} loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                ) : (
                  <div class="w-full h-full bg-surface-container-high flex items-center justify-center min-h-[200px]">
                    <span class="material-symbols-outlined text-[64px] text-on-surface-variant">restaurant</span>
                  </div>
                )}
              </div>
              <div class="p-4 flex flex-col gap-2 flex-grow">
                {review.data.categoryArray?.[0] && (
                  <span class="text-[12px] font-semibold uppercase tracking-widest text-secondary">{review.data.categoryArray[0]}</span>
                )}
                <h3 class="text-[24px] font-semibold text-primary-container group-hover:text-secondary transition-colors leading-tight"
                  style="font-family:'Playfair Display',serif;"
                >
                  {review.data.title}
                </h3>
                {review.data.locality && (
                  <p class="text-[12px] text-on-surface-variant uppercase tracking-widest">{review.data.locality}</p>
                )}
                <p class="text-[16px] text-on-surface-variant line-clamp-3 leading-relaxed">{review.data.description}</p>
              </div>
            </a>
          </div>
        ))}
      </div>

      <div id="no-results" class="hidden text-center py-16 border border-outline bg-surface-container mb-12">
        <p class="text-[18px] text-on-surface-variant mb-4">No se encontraron restaurantes con esos filtros.</p>
        <button id="btn-clear-2" class="px-6 py-3 border border-[#2b2f3a] text-[14px] font-bold uppercase tracking-widest text-primary hover:bg-surface-container transition-colors">
          Limpiar filtros
        </button>
      </div>

      <!-- Map -->
      <div class="border-t border-outline pt-8">
        <h2 class="text-[32px] font-semibold text-primary mb-4" style="font-family:'Playfair Display',serif;">Mapa de restaurantes</h2>
        <div id="map"></div>
      </div>

    </main>
    <Footer />

    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script is:inline define:vars={{ reviewsForClient, mapPoints }}>
      // === FILTROS ===
      const searchInput = document.getElementById('filter-search');
      const localitySelect = document.getElementById('filter-locality');
      const categorySelect = document.getElementById('filter-category');
      const priceRange = document.getElementById('filter-price');
      const priceDisplay = document.getElementById('price-display');
      const resultsInfo = document.getElementById('results-info');
      const noResults = document.getElementById('no-results');
      const grid = document.getElementById('reviews-grid');
      const cards = Array.from(grid.querySelectorAll('.review-card-wrapper'));

      function applyFilters() {
        const search = searchInput.value.toLowerCase().trim();
        const locality = localitySelect.value;
        const category = categorySelect.value;
        const maxPrice = parseInt(priceRange.value, 10);
        let visible = 0;
        cards.forEach((card) => {
          const title = card.dataset.title;
          const desc = card.dataset.description;
          const loc = card.dataset.locality;
          const cats = card.dataset.categories;
          const price = parseInt(card.dataset.price, 10);
          const matchSearch = !search || title.includes(search) || desc.includes(search);
          const matchLocality = !locality || loc === locality;
          const matchCategory = !category || cats.includes(category);
          const matchPrice = price === 0 || price <= maxPrice;
          const show = matchSearch && matchLocality && matchCategory && matchPrice;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        resultsInfo.textContent = `Mostrando ${visible} restaurante${visible !== 1 ? 's' : ''}`;
        noResults.classList.toggle('hidden', visible !== 0);
        grid.style.display = visible === 0 ? 'none' : '';
      }

      priceRange.addEventListener('input', () => { priceDisplay.textContent = priceRange.value + '€'; });
      [searchInput, localitySelect, categorySelect, priceRange].forEach((el) => {
        el.addEventListener('input', applyFilters);
        el.addEventListener('change', applyFilters);
      });

      function clearFilters() {
        searchInput.value = '';
        localitySelect.value = '';
        categorySelect.value = '';
        priceRange.value = priceRange.max;
        priceDisplay.textContent = priceRange.max + '€';
        applyFilters();
      }
      document.getElementById('btn-clear').addEventListener('click', clearFilters);
      document.getElementById('btn-clear-2').addEventListener('click', clearFilters);

      document.getElementById('btn-surprise').addEventListener('click', () => {
        const loc = document.getElementById('surprise-locality').value;
        let pool = reviewsForClient;
        if (loc) pool = pool.filter((r) => r.locality === loc);
        if (pool.length === 0) { alert('No hay reseñas disponibles.'); return; }
        const random = pool[Math.floor(Math.random() * pool.length)];
        window.location.href = `/reviews/${random.id}/`;
      });

      if (mapPoints.length > 0) {
        const map = L.map('map').setView([40.0, -3.7], 5);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a>',
          maxZoom: 18,
        }).addTo(map);
        const bounds = [];
        mapPoints.forEach((point) => {
          const ratingText = point.rating ? ` — ${point.rating}/10` : '';
          const marker = L.marker([point.lat, point.lng]).addTo(map);
          marker.bindPopup(`<strong><a href="/reviews/${point.id}/">${point.title}</a></strong><br/>${point.locality}${ratingText}`);
          bounds.push([point.lat, point.lng]);
        });
        if (bounds.length > 1) map.fitBounds(bounds, { padding: [40, 40] });
        else if (bounds.length === 1) map.setView(bounds[0], 12);
      } else {
        document.getElementById('map').innerHTML = '<p style="padding:2rem;text-align:center;color:gray;">No hay restaurantes con coordenadas para mostrar en el mapa.</p>';
      }
    </script>
  </body>
</html>
