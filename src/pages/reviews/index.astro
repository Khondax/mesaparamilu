---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CardReview from '../../components/CardReview.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('reviews')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Todas las reseñas — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1080px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
			}
			.page-header {
				text-align: center;
				margin-bottom: 2rem;
			}
			.page-header p {
				color: rgb(var(--gray));
			}
			.reviews-grid {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
			}
			@media (max-width: 720px) {
				.reviews-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="page-header">
				<h1>Todas las reseñas</h1>
				<p>{posts.length} restaurantes reseñados</p>
			</div>
			<div class="reviews-grid">
				{posts.map((post) => (
					<CardReview id={post.id} {...post.data} />
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
