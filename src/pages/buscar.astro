---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CardReview from '../components/CardReview.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const reviews = (await getCollection('reviews')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Extraer opciones únicas para filtros
const localities = [...new Set(reviews.map((r) => r.data.locality).filter(Boolean))].sort();
const categories = [...new Set(reviews.flatMap((r) => r.data.categoryArray ?? []))].sort();
const maxPrice = Math.max(...reviews.map((r) => r.data.averagePrice ?? 0));

// Serializar datos para el JS del cliente (solo lo necesario)
const reviewsForClient = reviews.map((r) => ({
	id: r.id,
	title: r.data.title,
	description: r.data.description,
	locality: r.data.locality,
	categories: r.data.categoryArray ?? [],
	averagePrice: r.data.averagePrice ?? 0,
	favorite: r.data.favorite,
	trending: r.data.trending,
	coordinates: r.data.coordinates ?? null,
}));

// Datos para el mapa
const mapPoints = reviews
	.filter((r) => r.data.coordinates)
	.map((r) => ({
		id: r.id,
		title: r.data.title,
		locality: r.data.locality,
		lat: r.data.coordinates!.lat,
		lng: r.data.coordinates!.lng,
		rating: r.data.rating
			? ((r.data.rating.food + r.data.rating.service + r.data.rating.ambiance + r.data.rating.value) / 4).toFixed(1)
			: null,
	}));
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Buscar — ${SITE_TITLE}`} description="Busca y filtra restaurantes por localidad, tipo de cocina, precio y más." />
		<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
		<style>
			main {
				width: 1080px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
			}

			.page-title {
				text-align: center;
				margin-bottom: 0.5rem;
			}
			.page-subtitle {
				text-align: center;
				color: rgb(var(--gray));
				margin-bottom: 2rem;
			}

			/* Filtros */
			.filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				align-items: flex-end;
				padding: 1.25rem;
				background: rgba(var(--gray-light), 0.5);
				border-radius: 12px;
				margin-bottom: 1.5rem;
			}
			.filter-group {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				flex: 1;
				min-width: 180px;
			}
			.filter-group label {
				font-size: 0.8rem;
				font-weight: 600;
				color: rgb(var(--gray-dark));
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.filter-group input,
			.filter-group select {
				padding: 0.5rem 0.75rem;
				border: 1px solid rgba(var(--gray), 0.3);
				border-radius: 8px;
				font-size: 0.9rem;
				font-family: inherit;
				background: rgb(var(--bg));
				color: rgb(var(--gray-dark));
				transition: border-color 0.2s;
			}
			.filter-group input:focus,
			.filter-group select:focus {
				outline: none;
				border-color: var(--accent);
			}
			.filter-actions {
				display: flex;
				align-items: flex-end;
				gap: 0.5rem;
			}
			.btn-clear {
				padding: 0.5rem 1rem;
				border: 1px solid rgba(var(--gray), 0.3);
				border-radius: 8px;
				background: rgb(var(--bg));
				color: rgb(var(--gray));
				cursor: pointer;
				font-size: 0.85rem;
				font-family: inherit;
				transition: all 0.2s;
				white-space: nowrap;
			}
			.btn-clear:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* Resultados */
			.results-info {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin-bottom: 1rem;
			}
			.reviews-grid {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
			}
			.no-results {
				text-align: center;
				padding: 3rem 1rem;
				color: rgb(var(--gray));
			}
			.no-results p {
				font-size: 1.1rem;
			}

			/* Mapa */
			.map-section {
				margin-bottom: 2rem;
			}
			.map-section h2 {
				margin-bottom: 0.75rem;
			}
			#map {
				width: 100%;
				height: 400px;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				z-index: 0;
			}

			/* Sorpréndeme */
			.surprise-section {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				align-items: flex-end;
				padding: 1.25rem;
				background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.05), rgba(var(--accent-rgb), 0.12));
				border-radius: 12px;
				margin-bottom: 2rem;
				border: 1px solid rgba(var(--accent-rgb), 0.15);
			}
			.surprise-section h3 {
				width: 100%;
				margin: 0 0 0.25rem 0;
				font-size: 1.1rem;
				color: var(--accent-dark);
			}
			.surprise-section select {
				flex: 1;
				min-width: 200px;
				padding: 0.5rem 0.75rem;
				border: 1px solid rgba(var(--gray), 0.3);
				border-radius: 8px;
				font-size: 0.9rem;
				font-family: inherit;
				background: rgb(var(--bg));
				color: rgb(var(--gray-dark));
			}
			.btn-surprise {
				padding: 0.6rem 1.5rem;
				border: none;
				border-radius: 8px;
				background: var(--accent);
				color: #fff;
				font-size: 0.95rem;
				font-weight: 600;
				font-family: inherit;
				cursor: pointer;
				transition: opacity 0.2s;
				white-space: nowrap;
			}
			.btn-surprise:hover {
				opacity: 0.85;
			}

			@media (max-width: 720px) {
				.filters {
					flex-direction: column;
				}
				.filter-group {
					min-width: 100%;
				}
				#map {
					height: 280px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<h1 class="page-title">🔍 Buscador de restaurantes</h1>
			<p class="page-subtitle">Filtra por nombre, localidad, tipo de cocina o rango de precio</p>

			{/* Sorpréndeme */}
			<div class="surprise-section">
				<h3>🎲 ¿No sabes dónde ir? ¡Sorpréndeme!</h3>
				<select id="surprise-locality">
					<option value="">Todas las localidades</option>
					{localities.map((loc) => <option value={loc}>{loc}</option>)}
				</select>
				<button class="btn-surprise" id="btn-surprise">Sorpréndeme</button>
			</div>

			{/* Filtros */}
			<div class="filters">
				<div class="filter-group">
					<label for="filter-search">Buscar</label>
					<input type="text" id="filter-search" placeholder="Nombre o descripción..." />
				</div>
				<div class="filter-group">
					<label for="filter-locality">Localidad</label>
					<select id="filter-locality">
						<option value="">Todas</option>
						{localities.map((loc) => <option value={loc}>{loc}</option>)}
					</select>
				</div>
				<div class="filter-group">
					<label for="filter-category">Cocina</label>
					<select id="filter-category">
						<option value="">Todas</option>
						{categories.map((cat) => <option value={cat}>{cat}</option>)}
					</select>
				</div>
				<div class="filter-group">
					<label for="filter-price">Precio máx. (€/persona)</label>
					<input type="range" id="filter-price" min="0" max={maxPrice || 150} step="5" value={maxPrice || 150} />
					<span id="price-display" style="font-size:0.8rem;color:rgb(var(--gray));">Hasta {maxPrice || 150}€</span>
				</div>
				<div class="filter-actions">
					<button class="btn-clear" id="btn-clear">Limpiar filtros</button>
				</div>
			</div>

			{/* Info resultados */}
			<p class="results-info" id="results-info">Mostrando {reviews.length} restaurantes</p>

			{/* Grid de tarjetas */}
			<div class="reviews-grid" id="reviews-grid">
				{reviews.map((review) => (
					<div
						class="review-card-wrapper"
						data-id={review.id}
						data-title={review.data.title.toLowerCase()}
						data-description={review.data.description.toLowerCase()}
						data-locality={review.data.locality}
						data-categories={(review.data.categoryArray ?? []).join(',')}
						data-price={review.data.averagePrice ?? 0}
						data-favorite={review.data.favorite}
						data-trending={review.data.trending}
					>
						<CardReview id={review.id} {...review.data} />
					</div>
				))}
			</div>
			<div class="no-results" id="no-results" style="display:none;">
				<p>😕 No se encontraron restaurantes con esos filtros.</p>
				<button class="btn-clear" id="btn-clear-2">Limpiar filtros</button>
			</div>

			{/* Mapa */}
			<div class="map-section">
				<h2>🗺️ Mapa de restaurantes</h2>
				<div id="map"></div>
			</div>
		</main>
		<Footer />

		{/* Leaflet JS */}
		<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

		{/* Datos inyectados para JS del cliente */}
		<script is:inline define:vars={{ reviewsForClient, mapPoints }}>
			// === FILTROS ===
			const searchInput = document.getElementById('filter-search');
			const localitySelect = document.getElementById('filter-locality');
			const categorySelect = document.getElementById('filter-category');
			const priceRange = document.getElementById('filter-price');
			const priceDisplay = document.getElementById('price-display');
			const resultsInfo = document.getElementById('results-info');
			const noResults = document.getElementById('no-results');
			const grid = document.getElementById('reviews-grid');
			const cards = Array.from(grid.querySelectorAll('.review-card-wrapper'));

			function applyFilters() {
				const search = searchInput.value.toLowerCase().trim();
				const locality = localitySelect.value;
				const category = categorySelect.value;
				const maxPrice = parseInt(priceRange.value, 10);

				let visible = 0;

				cards.forEach((card) => {
					const title = card.dataset.title;
					const desc = card.dataset.description;
					const loc = card.dataset.locality;
					const cats = card.dataset.categories;
					const price = parseInt(card.dataset.price, 10);

					const matchSearch = !search || title.includes(search) || desc.includes(search);
					const matchLocality = !locality || loc === locality;
					const matchCategory = !category || cats.includes(category);
					const matchPrice = price <= maxPrice || price === 0;

					const show = matchSearch && matchLocality && matchCategory && matchPrice;
					card.style.display = show ? '' : 'none';
					if (show) visible++;
				});

				resultsInfo.textContent = `Mostrando ${visible} restaurante${visible !== 1 ? 's' : ''}`;
				noResults.style.display = visible === 0 ? '' : 'none';
				grid.style.display = visible === 0 ? 'none' : '';
			}

			priceRange.addEventListener('input', () => {
				priceDisplay.textContent = `Hasta ${priceRange.value}€`;
			});

			[searchInput, localitySelect, categorySelect, priceRange].forEach((el) => {
				el.addEventListener('input', applyFilters);
				el.addEventListener('change', applyFilters);
			});

			function clearFilters() {
				searchInput.value = '';
				localitySelect.value = '';
				categorySelect.value = '';
				priceRange.value = priceRange.max;
				priceDisplay.textContent = `Hasta ${priceRange.max}€`;
				applyFilters();
			}

			document.getElementById('btn-clear').addEventListener('click', clearFilters);
			document.getElementById('btn-clear-2').addEventListener('click', clearFilters);

			// === SORPRÉNDEME ===
			document.getElementById('btn-surprise').addEventListener('click', () => {
				const loc = document.getElementById('surprise-locality').value;
				let pool = reviewsForClient;
				if (loc) {
					pool = pool.filter((r) => r.locality === loc);
				}
				if (pool.length === 0) {
					alert('No hay reseñas disponibles para esa selección.');
					return;
				}
				const random = pool[Math.floor(Math.random() * pool.length)];
				window.location.href = `/reviews/${random.id}/`;
			});

			// === MAPA ===
			if (mapPoints.length > 0) {
				const map = L.map('map').setView([40.0, -3.7], 5);
				L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
					attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a>',
					maxZoom: 18,
				}).addTo(map);

				const bounds = [];
				mapPoints.forEach((point) => {
					const ratingText = point.rating ? ` — ⭐ ${point.rating}` : '';
					const marker = L.marker([point.lat, point.lng]).addTo(map);
					marker.bindPopup(
						`<strong><a href="/reviews/${point.id}/">${point.title}</a></strong><br/>` +
						`📍 ${point.locality}${ratingText}`
					);
					bounds.push([point.lat, point.lng]);
				});

				if (bounds.length > 1) {
					map.fitBounds(bounds, { padding: [40, 40] });
				} else if (bounds.length === 1) {
					map.setView(bounds[0], 12);
				}
			} else {
				document.getElementById('map').innerHTML = '<p style="padding:2rem;text-align:center;color:gray;">No hay restaurantes con coordenadas para mostrar en el mapa.</p>';
			}
		</script>
	</body>
</html>
