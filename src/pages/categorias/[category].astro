---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { categorySlug } from '../../utils/slug';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  const bySlug = new Map();
  for (const r of reviews) {
    for (const cat of r.data.categoryArray ?? []) {
      const slug = categorySlug(cat);
      if (!slug) continue;
      if (!bySlug.has(slug)) bySlug.set(slug, { name: cat, posts: [] });
      bySlug.get(slug).posts.push(r);
    }
  }
  return [...bySlug.entries()].map(([slug, { name, posts }]) => ({
    params: { category: slug },
    props: { categoryName: name, posts: posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) },
  }));
}

const { categoryName, posts } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`${categoryName} — ${SITE_TITLE}`} description={`Reviews en la categoría ${categoryName}`} />
    <style>
      main {
        width: 960px;
      }
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        width: calc(50% - 1rem);
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li:first-child {
        width: 100%;
        margin-bottom: 1rem;
        text-align: center;
      }
      ul li:first-child img {
        width: 100%;
      }
      ul li:first-child .title {
        font-size: 2.369rem;
      }
      ul li img {
        margin-bottom: 0.5rem;
        border-radius: 12px;
      }
      ul li a {
        display: block;
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        line-height: 1;
      }
      .date {
        margin: 0;
        color: rgb(var(--gray));
      }
      ul li a:hover h4,
      ul li a:hover .date {
        color: rgb(var(--accent));
      }
      ul a:hover img {
        box-shadow: var(--box-shadow);
      }
      @media (max-width: 1080px) {
        ul {
          gap: 0.5em;
        }
        ul li {
          width: 100%;
          text-align: center;
        }
        ul li:first-child {
          margin-bottom: 0;
        }
        ul li:first-child .title {
          font-size: 1.563em;
        }
      }
      .category-header {
        text-align: center;
        margin: 2rem 0;
      }
      .category-header h1 {
        color: rgb(var(--black));
        margin: 0;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section>
        <div class="category-header">
          <h1>Categoría: {categoryName}</h1>
        </div>
        <ul>
          {
            posts.map((post) => (
              <li>
                <a href={`/reviews/${post.id}/`}>
                  <img width={1080} height={360} src={post.data.image} alt="" />
                  <h4 class="title">{post.data.title}</h4>
                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
