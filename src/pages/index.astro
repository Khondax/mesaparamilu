---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CardReview from '../components/CardReview.astro';
import FavoritesCarousel from '../components/FavoritesCarousel.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allReviews = (await getCollection('reviews')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const favorites = allReviews.filter((r) => r.data.favorite);
const latestReviews = allReviews.slice(0, 6);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-surface-container-low text-on-surface min-h-screen flex flex-col antialiased">
    <Header />
    <main id="main-content" class="flex-grow">

      <!-- Hero Section -->
      <section class="px-5 md:px-16 py-16 grid grid-cols-1 md:grid-cols-12 gap-6 items-center min-h-[600px]">
        <div class="md:col-span-5 flex flex-col gap-8 pr-6">
          <h1
            class="text-[clamp(2.5rem,5vw,4rem)] font-bold text-primary-container leading-tight"
            style="font-family:'Playfair Display',serif; letter-spacing:-0.02em;"
          >
            El arte de<br/>
            <span class="italic text-secondary">comer despacio</span>
          </h1>
          <p class="text-[18px] text-on-surface-variant max-w-md leading-relaxed" style="font-family:'Plus Jakarta Sans',sans-serif;">
            {SITE_DESCRIPTION}
          </p>
          <div class="flex gap-4 flex-wrap">
            <a
              href="/reviews"
              class="inline-flex items-center gap-2 px-6 py-3 bg-on-tertiary-container text-white text-[14px] font-bold uppercase tracking-widest border border-[#2b2f3a] shadow-[4px_4px_0px_0px_#2b2f3a] hover:shadow-[2px_2px_0px_0px_#2b2f3a] hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-200"
              style="font-family:'Plus Jakarta Sans',sans-serif;"
            >
              Ver reseñas
            </a>
            <a
              href="/buscar"
              class="inline-flex items-center gap-2 px-6 py-3 bg-[#FCE5CD] text-primary text-[14px] font-bold uppercase tracking-widest border border-[#2b2f3a] hover:bg-warm-linen transition-colors duration-200"
              style="font-family:'Plus Jakarta Sans',sans-serif;"
            >
              <span class="material-symbols-outlined" style="font-size:18px;">search</span>
              Buscar
            </a>
          </div>
        </div>
        <div class="md:col-span-7 h-full w-full relative group min-h-[400px]">
          <div class="absolute inset-0 bg-primary-container translate-x-4 translate-y-4 border border-[#2b2f3a]"></div>
          <div class="relative h-full w-full border border-[#2b2f3a] overflow-hidden bg-surface-container-lowest min-h-[400px]">
            {latestReviews[0]?.data.image ? (
              <img
                src={latestReviews[0].data.image}
                alt={latestReviews[0].data.title}
                class="w-full h-full object-cover grayscale-[20%] group-hover:scale-105 transition-transform duration-700"
                style="min-height:400px;"
              />
            ) : (
              <div class="w-full h-full bg-surface-container-high min-h-[400px] flex items-center justify-center">
                <span class="material-symbols-outlined text-[96px] text-on-surface-variant">restaurant</span>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- Latest Critiques -->
      <section class="px-5 md:px-16 py-16 bg-warm-linen border-y border-[#2b2f3a]">
        <div class="flex justify-between items-end mb-8">
          <h2
            class="text-[32px] font-semibold text-primary-container"
            style="font-family:'Playfair Display',serif;"
          >
            Últimas Reseñas
          </h2>
          <a
            href="/reviews"
            class="text-[14px] font-bold uppercase tracking-widest text-secondary hover:text-primary transition-colors border-b border-secondary pb-1"
            style="font-family:'Plus Jakarta Sans',sans-serif;"
          >
            Ver todas
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {latestReviews.map((review) => (
            <CardReview id={review.id} {...review.data} />
          ))}
        </div>
      </section>

      <!-- Favorites -->
      {favorites.length > 0 && (
        <section class="px-5 md:px-16 py-16">
          <div class="flex justify-between items-end mb-8">
            <h2
              class="text-[32px] font-semibold text-primary-container"
              style="font-family:'Playfair Display',serif;"
            >
              Nuestros Favoritos
            </h2>
          </div>
          <FavoritesCarousel favorites={favorites} />
        </section>
      )}

    </main>
    <Footer />
  </body>
</html>
