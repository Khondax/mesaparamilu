---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CardReview from '../components/CardReview.astro';
// import Newsletter from '../components/Newsletter.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allReviews = (await getCollection('reviews')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const favorites = allReviews.filter((r) => r.data.favorite);
const latestReviews = allReviews.slice(0, 10);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1080px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
			}

			/* Hero */
			.hero {
				text-align: center;
				padding: 2rem 0 1.5rem;
			}
			.hero h1 {
				font-size: 2.5rem;
				margin: 0 0 0.5rem 0;
			}
			.hero p {
				font-size: 1.1rem;
				color: rgb(var(--gray));
				margin: 0 0 1.5rem 0;
			}
			.hero-actions {
				display: flex;
				justify-content: center;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.7rem 1.5rem;
				border-radius: 8px;
				font-size: 0.95rem;
				font-weight: 600;
				font-family: inherit;
				text-decoration: none;
				transition: opacity 0.2s;
				cursor: pointer;
			}
			.btn:hover { opacity: 0.85; }
			.btn-primary {
				background: var(--accent);
				color: #fff;
				border: none;
			}
			.btn-secondary {
				background: transparent;
				color: var(--accent);
				border: 2px solid var(--accent);
			}

			/* Secciones */
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin: 2.5rem 0 1rem;
				border-bottom: 2px solid rgba(var(--gray-light), 0.8);
				padding-bottom: 0.5rem;
			}
			.section-header h2 {
				margin: 0;
				font-size: 1.5rem;
			}
			.section-header a {
				font-size: 0.9rem;
				color: var(--accent);
			}

			/* Grid */
			.reviews-grid {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
			}

			@media (max-width: 720px) {
				.hero h1 { font-size: 1.8rem; }
				.reviews-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			{/* Hero */}
			<div class="hero">
				<h1>Bienvenidos a nuestra mesa 🍴</h1>
				<p>Reseñas honestas de los restaurantes que más nos gustan, escritas por Miguel y Lucía.</p>
				<div class="hero-actions">
					<a href="/buscar" class="btn btn-primary">🔍 Buscar restaurantes</a>
					<a href="/reviews" class="btn btn-secondary">📋 Todas las reseñas</a>
				</div>
			</div>

			{/* Favoritos */}
			{favorites.length > 0 && (
				<>
					<div class="section-header">
						<h2>⭐ Nuestros favoritos</h2>
					</div>
					<div class="reviews-grid">
						{favorites.map((review) => (
							<CardReview id={review.id} {...review.data} />
						))}
					</div>
				</>
			)}

			{/* Últimas reseñas */}
			<div class="section-header">
				<h2>🕐 Últimas reseñas</h2>
				<a href="/reviews">Ver todas →</a>
			</div>
			<div class="reviews-grid">
				{latestReviews.map((review) => (
					<CardReview id={review.id} {...review.data} />
				))}
			</div>
			{/* Newsletter */}
			<!-- <Newsletter heading="📬 Suscríbete para no perderte nada" subtitle="Reseñas nuevas, descubrimientos y recomendaciones directamente en tu email." /> -->
		</main>
		<Footer />
	</body>
</html>