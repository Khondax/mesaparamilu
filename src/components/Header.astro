---
import { SITE_TITLE } from '../consts';
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---
<a href="#main-content" class="skip-to-content">Saltar al contenido</a>
<header class="w-full border-b border-[#2b2f3a] bg-surface-container sticky top-0 z-50">
  <nav
    aria-label="Navegación principal"
    class="flex justify-between items-center w-full px-5 md:px-16 py-6 max-w-full mx-auto"
  >
    <!-- Brand -->
    <a
      href="/"
      class="font-display-md text-[clamp(1.4rem,2.5vw,2.8rem)] tracking-tighter text-primary leading-none hover:opacity-80 transition-opacity"
      style="font-family:'Playfair Display',serif;"
    >
      {SITE_TITLE}
    </a>

    <!-- Nav Links (Desktop) -->
    <div class="hidden md:flex gap-8 items-center text-[14px] font-bold uppercase tracking-widest" style="font-family:'Plus Jakarta Sans',sans-serif;">
      <a
        href="/reviews"
        class:list={[
          'transition-colors duration-300 pb-1',
          isActive('/reviews')
            ? 'text-on-tertiary-container border-b-2 border-on-tertiary-container'
            : 'text-on-surface-variant hover:text-on-tertiary-container',
        ]}
      >Reseñas</a>
      <a
        href="/recipes"
        class:list={[
          'transition-colors duration-300 pb-1',
          isActive('/recipes')
            ? 'text-on-tertiary-container border-b-2 border-on-tertiary-container'
            : 'text-on-surface-variant hover:text-on-tertiary-container',
        ]}
      >Recetas</a>
      <a
        href="/about"
        class:list={[
          'transition-colors duration-300 pb-1',
          isActive('/about')
            ? 'text-on-tertiary-container border-b-2 border-on-tertiary-container'
            : 'text-on-surface-variant hover:text-on-tertiary-container',
        ]}
      >Nosotros</a>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <a
        href="/buscar"
        class="w-10 h-10 flex items-center justify-center border border-[#2b2f3a] text-primary hover:bg-surface-variant transition-colors"
        aria-label="Buscar"
      >
        <span class="material-symbols-outlined" style="font-size:20px">search</span>
      </a>
      <button
        id="mobile-menu-toggle"
        class="md:hidden w-10 h-10 flex items-center justify-center border border-[#2b2f3a] text-primary hover:bg-surface-variant transition-colors"
        aria-label="Menú"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined" style="font-size:20px">menu</span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[#2b2f3a] bg-surface-bright px-5 py-4"
  >
    <nav class="flex flex-col gap-4 text-[14px] font-bold uppercase tracking-widest" style="font-family:'Plus Jakarta Sans',sans-serif;">
      <a href="/reviews" class="text-on-surface-variant hover:text-on-tertiary-container transition-colors py-2">Reseñas</a>
      <a href="/recipes" class="text-on-surface-variant hover:text-on-tertiary-container transition-colors py-2">Recetas</a>
      <a href="/about" class="text-on-surface-variant hover:text-on-tertiary-container transition-colors py-2">Nosotros</a>
      <a href="/buscar" class="text-on-surface-variant hover:text-on-tertiary-container transition-colors py-2">Buscar</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>

