---
import { SITE_TITLE } from '../consts';
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---
<a href="#main-content" class="skip-to-content">Saltar al contenido</a>
<header class="w-full border-b border-[#2b2f3a] bg-warm-linen sticky top-0 z-50">
  <nav
    aria-label="Navegación principal"
    class="flex justify-between items-center w-full px-5 md:px-16 py-6 max-w-full mx-auto"
  >
    <!-- Brand -->
    <a
      href="/"
      class="font-display-md text-[clamp(1.4rem,2.5vw,2.8rem)] tracking-tighter text-primary leading-none hover:opacity-80 transition-opacity"
      style="font-family:'Playfair Display',serif;"
    >
      {SITE_TITLE}
    </a>

    <!-- Nav Links (Desktop) -->
    <div class="hidden md:flex gap-8 items-center text-[14px] font-bold uppercase tracking-widest" style="font-family:'Plus Jakarta Sans',sans-serif;">
      <a
        href="/reviews"
        class:list={[
          'transition-colors duration-300 pb-1',
          isActive('/reviews')
            ? 'text-on-tertiary-container border-b-2 border-on-tertiary-container'
            : 'text-on-surface-variant hover:text-on-tertiary-container',
        ]}
      >Reseñas</a>
      <a
        href="/buscar"
        class:list={[
          'transition-colors duration-300 pb-1',
          isActive('/buscar')
            ? 'text-on-tertiary-container border-b-2 border-on-tertiary-container'
            : 'text-on-surface-variant hover:text-on-tertiary-container',
        ]}
      >¿Buscas un restaurante?</a>
      <!-- <a
        href="/recipes"
        class:list={[
          'transition-colors duration-300 pb-1',
          isActive('/recipes')
            ? 'text-on-tertiary-container border-b-2 border-on-tertiary-container'
            : 'text-on-surface-variant hover:text-on-tertiary-container',
        ]}
      >Recetas</a> -->
      <a
        href="/about"
        class:list={[
          'transition-colors duration-300 pb-1',
          isActive('/about')
            ? 'text-on-tertiary-container border-b-2 border-on-tertiary-container'
            : 'text-on-surface-variant hover:text-on-tertiary-container',
        ]}
      >Nosotros</a>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <!-- <a
        href="/buscar"
        class="w-10 h-10 flex items-center justify-center border border-[#2b2f3a] text-primary hover:bg-surface-variant transition-colors"
        aria-label="Buscar"
      >
        <span class="material-symbols-outlined" style="font-size:20px">search</span>
      </a> -->

      <button
        id="mobile-menu-toggle"
        class="md:hidden w-10 h-10 flex items-center justify-center border border-[#2b2f3a] text-primary hover:bg-surface-variant transition-colors"
        aria-label="Menú"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined" style="font-size:20px">menu</span>
      </button>

      <a
        href="https://www.instagram.com/miguelkh94/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 border border-[#2b2f3a] flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container-high transition-colors"
        aria-label="Instagram"
      >
        <svg viewBox="0 0 22 22" aria-hidden="true" width="18" height="18" fill="currentColor">
          <path d="M17.34,5.46h0a1.2,1.2,0,1,0,1.2,1.2A1.2,1.2,0,0,0,17.34,5.46Zm4.6,2.42a7.59,7.59,0,0,0-.46-2.43,4.94,4.94,0,0,0-1.16-1.77,4.7,4.7,0,0,0-1.77-1.15,7.3,7.3,0,0,0-2.43-.47C15.06,2,14.72,2,12,2s-3.06,0-4.12.06a7.3,7.3,0,0,0-2.43.47A4.78,4.78,0,0,0,3.68,3.68,4.7,4.7,0,0,0,2.53,5.45a7.3,7.3,0,0,0-.47,2.43C2,8.94,2,9.28,2,12s0,3.06.06,4.12a7.3,7.3,0,0,0,.47,2.43,4.7,4.7,0,0,0,1.15,1.77,4.78,4.78,0,0,0,1.77,1.15,7.3,7.3,0,0,0,2.43.47C8.94,22,9.28,22,12,22s3.06,0,4.12-.06a7.3,7.3,0,0,0,2.43-.47,4.7,4.7,0,0,0,1.77-1.15,4.85,4.85,0,0,0,1.16-1.77,7.59,7.59,0,0,0,.46-2.43c0-1.06.06-1.4.06-4.12S22,8.94,21.94,7.88ZM20.14,16a5.61,5.61,0,0,1-.34,1.86,3.06,3.06,0,0,1-.75,1.15,3.19,3.19,0,0,1-1.15.75,5.61,5.61,0,0,1-1.86.34c-1,.05-1.37.06-4,.06s-3,0-4-.06A5.73,5.73,0,0,1,6.1,19.8,3.27,3.27,0,0,1,5,19.05a3,3,0,0,1-.74-1.15A5.54,5.54,0,0,1,3.86,16c0-1-.06-1.37-.06-4s0-3,.06-4A5.54,5.54,0,0,1,4.21,6.1,3,3,0,0,1,5,5,3.14,3.14,0,0,1,6.1,4.2,5.73,5.73,0,0,1,8,3.86c1,0,1.37-.06,4-.06s3,0,4,.06a5.61,5.61,0,0,1,1.86.34A3.06,3.06,0,0,1,19.05,5,3.06,3.06,0,0,1,19.8,6.1,5.61,5.61,0,0,1,20.14,8c.05,1,.06,1.37.06,4S20.19,15,20.14,16ZM12,6.87A5.13,5.13,0,1,0,17.14,12,5.12,5.12,0,0,0,12,6.87Zm0,8.46A3.33,3.33,0,1,1,15.33,12,3.33,3.33,0,0,1,12,15.33Z"/>
        </svg>
      </a>
      <!-- <a
        href="https://x.com/luciaa_bp"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 border border-[#2b2f3a] flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container-high transition-colors"
        aria-label="X / Twitter"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16" fill="currentColor">
          <path d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"/>
        </svg>
      </a> -->
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[#2b2f3a] bg-surface-bright px-5 py-4"
  >
    <nav class="flex flex-col gap-4 text-[14px] font-bold uppercase tracking-widest" style="font-family:'Plus Jakarta Sans',sans-serif;">
      <a href="/reviews" class="text-on-surface-variant hover:text-on-tertiary-container transition-colors py-2">Reseñas</a>
      <a href="/recipes" class="text-on-surface-variant hover:text-on-tertiary-container transition-colors py-2">Recetas</a>
      <a href="/about" class="text-on-surface-variant hover:text-on-tertiary-container transition-colors py-2">Nosotros</a>
      <a href="/buscar" class="text-on-surface-variant hover:text-on-tertiary-container transition-colors py-2">Buscar</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });
</script>

