---

<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
  {
		collectionReviews.map(review => (
			<CardReview 
				id={review.id}
				title={review.data.title}
				description={review.data.description}
				pubDate={review.data.pubDate}
				visitDate={review.data.visitDate}
				image={review.data.image}
				averagePrice={review.data.averagePrice}
				categoryArray={review.data.categoryArray}
				important={review.data.important}
			/>
		))
	}
</div>