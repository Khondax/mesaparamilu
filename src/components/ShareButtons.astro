---
/**
 * ShareButtons — Social share buttons for a review page.
 *
 * Pure HTML/CSS, no JS frameworks needed.
 * Uses Web Share API as progressive enhancement.
 */
interface Props {
  /** The full URL to share */
  url: string;
  /** The title/text for the share */
  title: string;
  /** Short description for platforms that support it */
  description?: string;
}

const { url, title, description = '' } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDesc = encodeURIComponent(description);
---

<div class="share-buttons" aria-label="Compartir en redes sociales">
  <span class="share-label">Compartir:</span>

  <a
    href={`https://x.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn share-x"
    title="Compartir en X"
  >
    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
      <path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z" />
    </svg>
    <span>X</span>
  </a>

  <a
    href={`https://wa.me/?text=${encodedTitle}%20${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn share-whatsapp"
    title="Compartir en WhatsApp"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>
    <span>WhatsApp</span>
  </a>

  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    class="share-btn share-facebook"
    title="Compartir en Facebook"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path fill="currentColor" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
    </svg>
    <span>Facebook</span>
  </a>

  <button
    type="button"
    class="share-btn share-copy"
    title="Copiar enlace"
    data-url={url}
    id="share-copy-btn"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
    </svg>
    <span id="copy-label">Copiar</span>
  </button>
</div>

<script>
  function setupShareButtons() {
    const copyBtn = document.getElementById('share-copy-btn');
    const copyLabel = document.getElementById('copy-label');
    if (!copyBtn || !copyLabel) return;

    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        copyLabel.textContent = '¡Copiado!';
        setTimeout(() => { copyLabel.textContent = 'Copiar'; }, 2000);
      } catch {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = url;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        copyLabel.textContent = '¡Copiado!';
        setTimeout(() => { copyLabel.textContent = 'Copiar'; }, 2000);
      }
    });
  }

  setupShareButtons();
  document.addEventListener('astro:after-swap', setupShareButtons);
</script>

<style>
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    background: rgb(var(--surface));
    border-radius: 10px;
    border: 1px solid rgba(var(--gray), 0.15);
    transition: background 0.3s ease;
  }
  .share-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(var(--gray));
    margin-right: 0.25rem;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    font-family: inherit;
    text-decoration: none;
    border: 1px solid rgba(var(--gray), 0.2);
    background: rgb(var(--bg));
    color: rgb(var(--gray-dark));
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .share-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .share-x:hover { color: #1da1f2; border-color: #1da1f2; }
  .share-whatsapp:hover { color: #25d366; border-color: #25d366; }
  .share-facebook:hover { color: #1877f2; border-color: #1877f2; }
  .share-copy:hover { color: var(--accent); border-color: var(--accent); }
</style>
