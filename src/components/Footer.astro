---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer class="w-full border-t border-[#2b2f3a] bg-warm-linen">
  <div class="grid grid-cols-1 md:grid-cols-2 w-full px-5 md:px-16 py-16 gap-6 max-w-full mx-auto">
    <div>
      <div
        class="text-[clamp(2rem,5vw,4rem)] font-bold tracking-tighter text-primary leading-none mb-4"
        style="font-family:'Playfair Display',serif;"
      >
        {SITE_TITLE}
      </div>
      <p class="text-[16px] text-on-surface" style="font-family:'Plus Jakarta Sans',sans-serif;">
        &copy; {today.getFullYear()} Ars Culinaria. Todos los derechos reservados.
      </p>
    </div>
    <div class="flex flex-col md:items-end justify-start gap-4">
      <nav class="flex flex-col md:flex-row gap-6 md:gap-8 text-[16px]" aria-label="Pie de página" style="font-family:'Plus Jakarta Sans',sans-serif;">
        <a href="/reviews" class="text-on-surface-variant hover:text-primary transition-colors hover:underline underline-offset-4">Reseñas</a>
        <a href="/buscar" class="text-on-surface-variant hover:text-primary transition-colors hover:underline underline-offset-4">Buscador</a>
        <!-- <a href="/recipes" class="text-on-surface-variant hover:text-primary transition-colors hover:underline underline-offset-4">Recetas</a> -->
        <a href="/about" class="text-on-surface-variant hover:text-primary transition-colors hover:underline underline-offset-4">Nosotros</a>
      </nav>
