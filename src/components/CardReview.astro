---
import type { ReviewData } from '../types/review';

interface Props extends ReviewData {
  id: string;
}

const {
  id,
  title,
  description,
  image,
  locality,
  averagePrice,
  categoryArray,
  favorite,
  trending,
  rating,
} = Astro.props;

function averageRating(r: ReviewData['rating']): string {
  if (!r) return '';
  const avg = (r.food + r.service + r.ambiance + r.value) / 4;
  return avg.toFixed(1);
}

const avg = rating ? averageRating(rating) : null;
const primaryCategory = categoryArray && categoryArray.length > 0 ? categoryArray[0] : null;
---

<a
  href={`/reviews/${id}/`}
  class="group flex flex-col border border-[#2b2f3a] bg-surface-container-low hover:shadow-[4px_4px_0px_0px_#2b2f3a] hover:-translate-y-1 transition-all duration-300"
  style="font-family:'Plus Jakarta Sans',sans-serif;"
>
  <!-- Image -->
  <div class="aspect-[4/3] w-full overflow-hidden border-b border-[#2b2f3a] relative">
    {avg && (
      <div class="absolute top-4 left-4 bg-[#f86630] text-[#003049] text-[14px] font-bold px-3 py-1 border border-[#2b2f3a] z-10 shadow-[2px_2px_0px_0px_#003049] uppercase tracking-widest">
        {avg}/10
      </div>
    )}
    {favorite && (
      <div class="absolute top-4 right-4 bg-primary-container text-on-primary-container text-[12px] font-bold px-2 py-1 border border-[#2b2f3a] z-10 uppercase tracking-widest">
        Favorito
      </div>
    )}
    {image ? (
      <img
        src={image}
        alt={`Restaurante ${title}`}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full bg-surface-container-high flex items-center justify-center">
        <span class="material-symbols-outlined text-[48px] text-on-surface-variant">restaurant</span>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="p-4 flex flex-col gap-2 flex-grow">
    {primaryCategory && (
      <span class="text-[12px] font-semibold uppercase tracking-widest text-secondary">
        {primaryCategory}
      </span>
    )}
    <h3 class="text-[24px] font-semibold text-primary-container group-hover:text-secondary transition-colors leading-tight"
      style="font-family:'Playfair Display',serif;"
    >
      {title}
    </h3>
    {locality && (
      <p class="text-[12px] text-on-surface-variant uppercase tracking-widest">{locality}</p>
    )}
    <p class="text-[16px] text-on-surface-variant line-clamp-3 leading-relaxed">{description}</p>

    <!-- Footer -->
    <div class="mt-auto pt-3 border-t border-outline-variant flex items-center justify-between">
      {averagePrice && (
        <span class="text-[12px] text-on-surface-variant uppercase tracking-widest">~{averagePrice}€/pax</span>
      )}
      {trending && (
        <span class="text-[12px] font-bold text-on-tertiary-container uppercase tracking-widest">Tendencia</span>
      )}
    </div>
  </div>
</a>
