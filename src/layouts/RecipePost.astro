---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'recipes'>['data'];

const { title, description, pubDate, updatedDate, image: heroImage } = Astro.props;
---

<html lang="es" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>
  <body class="bg-surface text-on-surface antialiased" style="font-family:'Plus Jakarta Sans',sans-serif;">
    <Header />
    <main class="w-full">
      <section class="w-full bg-surface-container-low pt-16 pb-16 border-b border-outline px-5 md:px-16">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block border-b border-outline pb-1 mb-4 text-[12px] font-semibold uppercase tracking-widest text-on-surface-variant">Receta</span>
          <h1 class="text-[clamp(2rem,5vw,4rem)] font-bold text-primary mb-4 leading-tight" style="font-family:'Playfair Display',serif; letter-spacing:-0.02em;">{title}</h1>
          <p class="text-[18px] text-on-surface-variant max-w-2xl mx-auto leading-relaxed">{description}</p>
          <div class="mt-6 text-[12px] text-on-surface-variant uppercase tracking-widest">
            <FormattedDate date={pubDate} />
            {updatedDate && (<span> · Actualizado: <FormattedDate date={updatedDate} /></span>)}
          </div>
        </div>
      </section>
      {heroImage && (
        <section class="w-full px-5 md:px-16 py-8">
          <div class="max-w-4xl mx-auto">
            <div class="w-full h-[400px] md:h-[500px] border border-outline relative shadow-[4px_4px_0px_0px_#001c38] overflow-hidden">
              <img src={heroImage} alt={`Imagen de ${title}`} class="w-full h-full object-cover" />
            </div>
          </div>
        </section>
      )}
      <section class="w-full px-5 md:px-16 pb-16">
        <article class="max-w-3xl mx-auto prose-content"><slot /></article>
      </section>
    </main>
    <Footer />
  </body>
</html>
