---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import InstagramEmbed from '../components/InstagramEmbed.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { categorySlug } from '../utils/slug';

type Props = CollectionEntry<'reviews'>['data'];

const {
  title,
  description,
  pubDate,
  updatedDate,
  visitDate,
  image: heroImage,
  address,
  locality,
  averagePrice,
  categoryArray,
  favorite,
  trending,
  rating,
  restaurantLinks,
  anecdote,
  instagramPostId,
} = Astro.props;

function ratingAvg(r: Props['rating']): string {
  if (!r) return '';
  return ((r.food + r.service + r.ambiance + r.value) / 4).toFixed(1);
}

const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="es" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>
  <body class="bg-surface text-on-surface antialiased" style="font-family:'Plus Jakarta Sans',sans-serif;">
    <Header />
    <main class="w-full">

      <!-- Hero Section -->
      <section class="w-full bg-surface-container-low pt-16 pb-16 border-b border-outline px-5 md:px-16">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
          <div class="md:col-span-8 md:col-start-3 text-center">
            {(categoryArray && categoryArray.length > 0) && (
              <span class="inline-block border-b border-outline pb-1 mb-4 text-[12px] font-semibold uppercase tracking-widest text-on-surface-variant">
                {categoryArray.map((cat, idx) => (
                  <>
                    <a href={`/categorias/${categorySlug(cat)}/`} class="hover:text-secondary transition-colors">{cat}</a>
                    {idx < categoryArray.length - 1 && ' • '}
                  </>
                ))}{locality && ` • ${locality}`}
              </span>
            )}
            <h1
              class="text-[clamp(2rem,5vw,4rem)] font-bold text-primary mb-4 leading-tight"
              style="font-family:'Playfair Display',serif; letter-spacing:-0.02em;"
            >
              {title}
            </h1>
            <p class="text-[18px] text-on-surface-variant max-w-2xl mx-auto leading-relaxed">{description}</p>
          </div>
        </div>
      </section>

      <!-- Feature Image -->
      {heroImage && (
        <section class="w-full px-5 md:px-16 py-8">
          <div class="max-w-7xl mx-auto">
            <div class="w-full h-[400px] md:h-[600px] border border-outline relative shadow-[4px_4px_0px_0px_#001c38] overflow-hidden">
              <img
                src={heroImage}
                alt={`Imagen de ${title}`}
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </section>
      )}

      <!-- Content Grid -->
      <section class="w-full px-5 md:px-16 pb-16">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-16">

          <!-- Main Column -->
          <article class="md:col-span-8">

            <!-- Meta: date, badges -->
            <div class="flex flex-wrap items-center gap-4 mb-8 pb-4 border-b border-outline">
              <span class="text-[12px] text-on-surface-variant uppercase tracking-widest">
                <FormattedDate date={pubDate} />
              </span>
              {visitDate && (
                <span class="text-[12px] text-on-surface-variant uppercase tracking-widest">
                  Visitado: <FormattedDate date={visitDate} />
                </span>
              )}
              {favorite && (
                <span class="text-[12px] font-bold text-on-tertiary-container uppercase tracking-widest border border-on-tertiary-container px-2 py-0.5">Favorito</span>
              )}
              {trending && (
                <span class="text-[12px] font-bold text-primary uppercase tracking-widest border border-primary px-2 py-0.5">Tendencia</span>
              )}
            </div>

            <!-- Anecdote -->
            {anecdote && (
              <aside class="mb-8 p-6 bg-surface-container border border-on-tertiary-container shadow-[4px_4px_0px_0px_#f86630] relative">
                <div class="absolute -top-4 left-6 bg-surface-container px-2 border border-on-tertiary-container">
                  <span class="text-[14px] font-bold uppercase tracking-widest text-on-tertiary-container">Anécdota</span>
                </div>
                <p class="text-[18px] text-primary italic leading-relaxed">{anecdote}</p>
              </aside>
            )}

            <!-- MDX content -->
            <div class="prose-content">
              <slot />
            </div>

            <!-- Instagram Embed -->
            <InstagramEmbed instagramPostId={instagramPostId} />

            <!-- Share Buttons -->
            <div class="mt-8 pt-8 border-t border-outline">
              <ShareButtons url={shareUrl} title={title} description={description} />
            </div>
          </article>

          <!-- Sidebar -->
          <aside class="md:col-span-4">
            <div class="sticky top-24 border border-outline bg-surface-bright p-6 shadow-[4px_4px_0px_0px_#001c38]">

              <h3
                class="text-[24px] font-semibold text-primary border-b border-outline pb-2 mb-4"
                style="font-family:'Playfair Display',serif;"
              >
                Ficha
              </h3>

              <dl class="space-y-4 mb-6 text-[16px]">
                <div>
                  <dt class="text-[12px] font-semibold uppercase tracking-widest text-on-surface-variant mb-1">Restaurante</dt>
                  <dd class="text-primary font-semibold">{title}</dd>
                </div>
                {locality && (
                  <div>
                    <dt class="text-[12px] font-semibold uppercase tracking-widest text-on-surface-variant mb-1">Localidad</dt>
                    <dd class="text-on-surface">{locality}</dd>
                  </div>
                )}
                {address && (
                  <div>
                    <dt class="text-[12px] font-semibold uppercase tracking-widest text-on-surface-variant mb-1">Dirección</dt>
                    <dd class="text-on-surface">{address}</dd>
                  </div>
                )}
                {averagePrice && (
                  <div>
                    <dt class="text-[12px] font-semibold uppercase tracking-widest text-on-surface-variant mb-1">Precio medio</dt>
                    <dd class="text-primary font-semibold">~{averagePrice}€/persona</dd>
                  </div>
                )}
                {restaurantLinks?.website && (
                  <div>
                    <dt class="text-[12px] font-semibold uppercase tracking-widest text-on-surface-variant mb-1">Web</dt>
                    <dd>
                      <a href={restaurantLinks.website} target="_blank" rel="noopener noreferrer" class="text-secondary hover:underline underline-offset-4 decoration-1">
                        {restaurantLinks.website.replace(/^https?:\/\//, '')}
                      </a>
                    </dd>
                  </div>
                )}
              </dl>

              <!-- Ratings -->
              {rating && (
                <>
                  <h4 class="text-[14px] font-bold uppercase tracking-widest text-primary border-b border-outline pb-2 mb-4" style="font-family:'Plus Jakarta Sans',sans-serif;">
                    Puntuaciones
                  </h4>
                  <div class="space-y-4 mb-6">
                    {[
                      { label: 'Comida', score: rating.food },
                      { label: 'Servicio', score: rating.service },
                      { label: 'Ambiente', score: rating.ambiance },
                      { label: 'Calidad-precio', score: rating.value },
                    ].map(({ label, score }) => (
                      <div>
                        <div class="flex justify-between text-[12px] font-semibold text-on-surface mb-1">
                          <span>{label}</span>
                          <span>{score}/10</span>
                        </div>
                        <div class="w-full h-1 bg-surface-variant border border-outline-variant overflow-hidden">
                          <div class="h-full bg-secondary" style={`width:${score * 10}%`}></div>
                        </div>
                      </div>
                    ))}
                  </div>

                  <!-- Verdict Box -->
                  <div class="p-4 bg-surface-container border border-on-tertiary-container shadow-[4px_4px_0px_0px_#f86630] relative">
                    <div class="absolute -top-3 left-4 bg-surface-container px-2 border border-on-tertiary-container">
                      <span class="text-[12px] font-bold uppercase tracking-widest text-on-tertiary-container">Veredicto</span>
                    </div>
                    <div class="flex items-center gap-4">
                      <div class="bg-on-tertiary-container text-on-primary text-[32px] font-bold px-4 py-2 border border-primary" style="font-family:'Playfair Display',serif;">
                        {ratingAvg(rating)}
                      </div>
                      <span class="text-[14px] font-bold uppercase tracking-widest text-on-surface-variant">
                        {
                          parseFloat(ratingAvg(rating)) >= 10 ? 'Magistral' :
                          parseFloat(ratingAvg(rating)) >= 9 ? 'Referente' :
                          parseFloat(ratingAvg(rating)) >= 8 ? 'Excelente' :
                          parseFloat(ratingAvg(rating)) >= 7 ? 'Muy recomendable' :
                          parseFloat(ratingAvg(rating)) >= 6 ? 'Recomendable' :
                          parseFloat(ratingAvg(rating)) >= 5 ? 'Aceptable' :
                          parseFloat(ratingAvg(rating)) >= 4 ? 'Mejorable' :
                          parseFloat(ratingAvg(rating)) >= 3 ? 'Flojo' :
                          parseFloat(ratingAvg(rating)) >= 2 ? 'Fiasco' :
                          parseFloat(ratingAvg(rating)) >= 1 ? 'Malo' : 'Inaceptable'
                        }
                      </span>
                    </div>
                  </div>
                </>
              )}

              <!-- Restaurant Links -->
              {restaurantLinks && (
                <nav class="mt-4 flex flex-col gap-2" aria-label="Enlaces del restaurante">
                  {restaurantLinks.reservations && (
                    <a href={restaurantLinks.reservations} target="_blank" rel="noopener noreferrer"
                      class="flex items-center gap-2 px-4 py-2 border border-[#2b2f3a] text-[14px] font-bold uppercase tracking-widest text-primary hover:bg-surface-container transition-colors">
                      <span class="material-symbols-outlined text-[16px]">event_available</span>
                      Reservar
                    </a>
                  )}
                  {restaurantLinks.googleMaps && (
                    <a href={restaurantLinks.googleMaps} target="_blank" rel="noopener noreferrer"
                      class="flex items-center gap-2 px-4 py-2 border border-[#2b2f3a] text-[14px] font-bold uppercase tracking-widest text-primary hover:bg-surface-container transition-colors">
                      <span class="material-symbols-outlined text-[16px]">location_on</span>
                      Ver en mapa
                    </a>
                  )}
                </nav>
              )}
            </div>
          </aside>

        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>
