# Copia este archivo como .env y rellena los valores necesarios.

# ------ Instagram Graph API (Opcional) ------
# Necesitas una Business account de Instagram + Facebook App.
# Guía: https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_ACCESS_TOKEN=

# Umbral de impresiones para considerar un post "trending" (default: 1000)
INSTAGRAM_TRENDING_THRESHOLD=1000
